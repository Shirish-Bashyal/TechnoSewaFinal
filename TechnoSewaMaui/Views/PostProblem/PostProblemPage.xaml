<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:TechnoSewaMaui.ViewModel.PostProblem"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="TechnoSewaMaui.Views.PostProblem.PostProblemPage"
             x:DataType="viewmodel:PostProblemViewModel"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="Modal"
             BackgroundColor="#F5F7FA">

    <ContentPage.Resources>
        <Style x:Key="InvalidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Red" />
        </Style>
        <Style x:Key="ValidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Black" />
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="TextColor" Value="#333333"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style TargetType="Frame">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HasShadow" Value="False"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <Grid RowDefinitions="*,Auto,Auto" RowSpacing="15" Padding="20">

            <!-- Main Components (Row 0) -->
            <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="15">

                <!-- Header (Row 0) -->
                <Frame Grid.Row="0" BackgroundColor="Transparent" Padding="0" HasShadow="False">
                    <Label Text="Express Your Problem"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#385897"
                           HorizontalOptions="Center"/>
                </Frame>

                <!-- Category (Row 1) -->
                <!-- Category (Row 1) -->
                <Frame Grid.Row="1">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Category"
               FontAttributes="Bold"
               TextColor="#385897"/>    

                        <Picker x:Name="CategoryPicker"
                Title="Select Category"
                ItemsSource="{Binding Categories}"
                SelectedItem="{Binding SelectedCategory}"
                TextColor="Black">
                           
                        </Picker>
                    </VerticalStackLayout>
                </Frame>
                <!-- Title (Row 2) -->
                <Frame Grid.Row="2">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Title"
                               FontAttributes="Bold"
                               TextColor="#385897"/>
                        <Entry 
                            Text="{Binding Title }"
                               Placeholder="Enter a title for your problem"
                               TextColor="Black"
                               ReturnType="Next"
                               toolkit:SetFocusOnEntryCompletedBehavior.NextElement="{x:Reference Description}">
                            <Entry.Behaviors>
                                <toolkit:CharactersValidationBehavior 
                                    InvalidStyle="{StaticResource InvalidEntryStyle}"
                                    ValidStyle="{StaticResource ValidEntryStyle}"
                                    Flags="ValidateOnValueChanged"
                                    CharacterType="Alphanumeric"
                                    MinimumCharacterTypeCount="5"/>
                            </Entry.Behaviors>
                        </Entry>
                    </VerticalStackLayout>
                </Frame>

                <!-- Description (Row 3) -->
                <Frame Grid.Row="3">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Description"
                               FontAttributes="Bold"
                               TextColor="#385897"/>

                        <Editor x:Name="Description"
                                Text="{Binding Description}"
                               Placeholder="Enter a description of the problem"
                               AutoSize="TextChanges"
                               MinimumHeightRequest="100"
                               >
                            <Editor.Behaviors>
                                <toolkit:CharactersValidationBehavior 
                                    InvalidStyle="{StaticResource InvalidEntryStyle}"
                                    ValidStyle="{StaticResource ValidEntryStyle}"
                                    Flags="ValidateOnValueChanged"
                                    CharacterType="Alphanumeric"
                                    MinimumCharacterTypeCount="10"/>
                            </Editor.Behaviors>
                        </Editor>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Action Icons (Row 1) -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="20" Padding="0,10">
                <Frame Grid.Column="0">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Image Source="location.png" HeightRequest="24" WidthRequest="24"/>
                        <Label Text="Location" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnLocationTapped}"/>
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame Grid.Column="1">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Image Source="plus.png" HeightRequest="24" WidthRequest="24"/>
                        <Label Text="Add Photo" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnAddPhotosTapped}"/>
                    </Frame.GestureRecognizers>
                </Frame>
            </Grid>

            <!-- Submit Button (Row 2) -->
            <Button Grid.Row="2"
                    Text="SUBMIT"
                    BackgroundColor="#385897"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,10,0,0"
                    Command="{Binding OnSubmitTapped}"/>
        </Grid>
    </ScrollView>
</ContentPage>