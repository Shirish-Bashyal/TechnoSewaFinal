<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:TechnoSewaMaui.ViewModel.PostProblem"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="TechnoSewaMaui.Views.PostProblem.PostProblemPage"
             x:DataType="viewmodel:PostProblemViewModel"
             Shell.TabBarIsVisible="False"
              Shell.NavBarIsVisible="False"
              Shell.PresentationMode="Modal"
             BackgroundColor="#F5F7FA"
            >
    <ContentPage.Resources>
        <Style x:Key="InvalidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Red" />
        </Style>
        <Style x:Key="ValidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Black" />
        </Style>
   
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="TextColor" Value="#333333"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style TargetType="Frame">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HasShadow" Value="False"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <Grid RowDefinitions="*,Auto" RowSpacing="25" Padding="20">

            <!-- Main Components (Row 0) -->
            <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="15">

                <!-- Header (Row 0) -->
                <Frame Grid.Row="0" BackgroundColor="Transparent" Padding="0" HasShadow="False">
                    <Label Text="Express Your Problem"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#385897"
                           HorizontalOptions="Center"/>
                </Frame>

                <!-- Category (Row 1) -->
                <Frame Grid.Row="1">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Category"
                               FontAttributes="Bold"
                               TextColor="#385897"/>

                        <Picker Title="Select Category"
                                
                                TextColor="Black">
                        </Picker>
                    </VerticalStackLayout>
                </Frame>

                <!-- Description (Row 2) -->
                <Frame Grid.Row="2">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Description"
                               FontAttributes="Bold"
                               TextColor="#385897"/>

                        <Editor Placeholder="Enter a description of the problem"
                              
                               AutoSize="TextChanges"
                               MinimumHeightRequest="100"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Location (Row 3) -->
                <Frame Grid.Row="3">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Location"
                               FontAttributes="Bold"
                               TextColor="#385897"/>

                        <Entry Placeholder="Enter the location"
                               Text="ahh"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Photos (Row 4) -->
                <Frame Grid.Row="4">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Photos"
                               FontAttributes="Bold"
                               TextColor="#385897"/>

                        <Label Text="Upload up to 4 photos"
                               FontSize="14"
                               TextColor="#666666"/>

                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                            <!-- Image Slots -->
                            <Frame Grid.Column="0" Padding="0" HeightRequest="80">
                                
                            </Frame>

                            <!-- Repeat for columns 1-3 -->

                            <!-- Add Button -->
                            <ImageButton Grid.Column="3"
                                         Source="add_photo.png"
                                         BackgroundColor="Transparent"
                                         HeightRequest="80"
                                         WidthRequest="80"
                                         />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Submit Button (Row 1) -->
            <Button Grid.Row="1"
                    Text="SUBMIT"
                  
                    BackgroundColor="#385897"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,10,0,0"/>
        </Grid>
    </ScrollView>
</ContentPage>