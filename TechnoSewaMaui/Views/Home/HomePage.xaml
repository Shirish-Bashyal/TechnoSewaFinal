<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TechnoSewaMaui.Views.Home.HomePage"
             xmlns:viewmodel="clr-namespace:TechnoSewaMaui.ViewModel.Home"
             x:DataType="viewmodel:HomeViewModel"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="Modal"
             BackgroundColor="#F5F7FA">

   

    <Grid RowDefinitions="auto,auto,*,*,auto" 
          Padding="0" 
          Margin="0" 
          HorizontalOptions="Fill" 
          VerticalOptions="Fill"
          RowSpacing="0">

        <!-- Header with rounded icon backgrounds -->
        <Grid Grid.Row="0" RowDefinitions="Auto, *" Padding="0,0,10,10" BackgroundColor="#3F51B5" HorizontalOptions="Fill" VerticalOptions="End">
            <Grid Grid.Row="0" VerticalOptions="Start" ColumnDefinitions="*,*" Padding="0">
                <!-- Left icon with round background -->
              
                    <Image Grid.Column="0" HorizontalOptions="Start"  Source="logo.png" 
           Aspect="AspectFit" 
           HeightRequest="80" 
           WidthRequest="80"/>
               


                <!-- Right icons with round backgrounds -->
                <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" HorizontalOptions="End">
                    <Frame   Grid.Column="0" 
                           Margin="5" 
                           CornerRadius="25" 
                           HeightRequest="50" 
                           WidthRequest="50"
                           Padding="0"
                           BackgroundColor="#5C6BC0"
                           HasShadow="False">
                        <Image  Source="notification.png" 
                               Aspect="AspectFit" 
                               HeightRequest="40" 
                               WidthRequest="40"/>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnNotificationTapped}" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    
                    <Frame Grid.Column="1" 
       CornerRadius="25" 
       HeightRequest="50" 
       WidthRequest="50"
       Padding="0"
       BackgroundColor="#5C6BC0"
       HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnLocationTapped}"/>
                        </Frame.GestureRecognizers>
                        <Image Source="location.png" 
           Aspect="AspectFit" 
           HeightRequest="40" 
           WidthRequest="40"/>
                    </Frame>
                </Grid>
            </Grid>

            <!-- Welcome text -->
            <Grid Grid.Row="1" VerticalOptions="End" Padding="0,0,0,20">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2" Padding="0,0,0,10">
                    <Label Text="WELCOME" 
                           FontAttributes="Bold" 
                           FontSize="30" 
                           TextColor="White"
                           HorizontalOptions="Center"/>
                    <Label Text="to our services" 
                           FontSize="24" 
                           TextColor="White"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- Carousel (unchanged) -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="-10" Padding="0">
            <CarouselView ItemsSource="{Binding ImageList}"
              Loop="False"
              HeightRequest="250"
              WidthRequest="{OnPlatform Android=300, iOS=300, WinUI=400}"
              HorizontalOptions="Center"
              VerticalOptions="Center">

                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <!-- Use Grid instead of StackLayout for better control -->
                        <Grid>
                            <Image Source="{Binding}"
                       Aspect="AspectFit"  
                                HeightRequest="250"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                        </Grid>
                    </DataTemplate>
                </CarouselView.ItemTemplate>

                <!-- IndicatorView -->
                <CarouselView.IndicatorView>
                    <IndicatorView IndicatorColor="LightGray"
                      SelectedIndicatorColor="#3F51B5"
                      HorizontalOptions="Center"
                      Margin="0,10,0,0"/>
                </CarouselView.IndicatorView>
            </CarouselView>
        </Grid>

        <!-- Hire Personnel Section -->
        <Grid Grid.Row="2" RowDefinitions="auto,auto,auto" Padding="20" RowSpacing="15">
            <!-- Title -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F5F7FA" Offset="0.0"/>
                    <!-- Lightest shade -->
                    <GradientStop Color="#EEF1F5" Offset="0.5"/>
                    <!-- Soft transition -->
                    <GradientStop Color="#EEEEEE" Offset="1.0"/>
                    <!-- Slightly deeper gray -->
                </LinearGradientBrush>
            </Grid.Background>
            <Label Grid.Row="0" 
               Text="Hire Personnel" 
               FontSize="22" 
               FontAttributes="Bold" 
               TextColor="#145DA0"
               HorizontalOptions="Start" 
               VerticalOptions="Center"/>

            <!-- First row of 3 icons -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="20">
                <StackLayout Grid.Column="0" Spacing="8" HorizontalOptions="Center">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnPersonnelTapped}" />
                    </StackLayout.GestureRecognizers>
                    <Image Source="dotnet_bot.png" HeightRequest="60" WidthRequest="60"/>
                    <Label Text="Plumbing" TextColor="#145DA0" FontSize="14" HorizontalOptions="Center" FontAttributes="Bold"/>
                </StackLayout>
                <StackLayout Grid.Column="1" Spacing="8" HorizontalOptions="Center">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnPersonnelTapped}" />
                    </StackLayout.GestureRecognizers>
                    <Image Source="dotnet_bot.png" HeightRequest="60" WidthRequest="60"/>
                    <Label TextColor="#145DA0" Text="Electrical" FontSize="14" HorizontalOptions="Center" FontAttributes="Bold"/>
                </StackLayout>
                <StackLayout Grid.Column="2" Spacing="8" HorizontalOptions="Center">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnPersonnelTapped}" />
                    </StackLayout.GestureRecognizers>
                    <Image Source="dotnet_bot.png" HeightRequest="60" WidthRequest="60"/>
                    <Label TextColor="#145DA0" Text="Cleaning" FontSize="14" HorizontalOptions="Center" FontAttributes="Bold"/>
                </StackLayout>
            </Grid>

            <!-- Second row of 3 icons -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="20">
                <StackLayout Grid.Column="0" Spacing="8" HorizontalOptions="Center">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnPersonnelTapped}" />
                    </StackLayout.GestureRecognizers>
                    <Image Source="dotnet_bot.png" HeightRequest="60" WidthRequest="60"/>
                    <Label TextColor="#145DA0" Text="Painting" FontSize="14" HorizontalOptions="Center" FontAttributes="Bold"/>
                </StackLayout>
                <StackLayout Grid.Column="1" Spacing="8" HorizontalOptions="Center">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnPersonnelTapped}" />
                    </StackLayout.GestureRecognizers>
                    <Image Source="dotnet_bot.png" HeightRequest="60" WidthRequest="60"/>
                    
                   
                    <Label TextColor="#145DA0" Text="Carpentry" FontSize="14" HorizontalOptions="Center" FontAttributes="Bold"/>
                </StackLayout>
                <StackLayout Grid.Column="2" Spacing="8" HorizontalOptions="Center">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnPersonnelTapped}" />
                    </StackLayout.GestureRecognizers>
                    <Image Source="dotnet_bot.png" HeightRequest="60" WidthRequest="60"/>
                    <Label  TextColor="#145DA0" Text="AC Repair" FontSize="14" HorizontalOptions="Center" FontAttributes="Bold"/>
                </StackLayout>
            </Grid>


            <Grid Grid.Row="1">

                <Image 
                    Source="bot.png" 
                    HeightRequest="60"
                    WidthRequest="60"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="20"
                    ZIndex="99"
                    BackgroundColor="Transparent"
                    Aspect="AspectFit"> 
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnChatbotTapped}" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>