<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TechnoSewaMaui.Views.Profile.ProfilePage"
             xmlns:viewmodel="clr-namespace:TechnoSewaMaui.ViewModel.Profile"
             x:DataType="viewmodel:ProfileViewModel"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="Modal"
              BackgroundColor="#F5F7FA">

    <Grid RowDefinitions="Auto,*" 
          RowSpacing="0"
          
          VerticalOptions="FillAndExpand">

       

        <Label Grid.Row="0" 
               Text="Profile" 
               FontSize="24"
               FontAttributes="Bold"
               TextColor="#385897"
               HorizontalOptions="Start"
               VerticalOptions="Center"
               Margin="20,15"/>

        <Grid RowDefinitions="auto, auto,*" Grid.Row="1"
               BackgroundColor="White"
              RowSpacing="20"
               
               Padding="0"
               HorizontalOptions="Fill"
               VerticalOptions="Fill">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" 
                  ColumnSpacing="35"
                  Padding="20,30,20,20"
                  VerticalOptions="Start">

                <Frame Grid.Column="0"
                       HeightRequest="100"
                       WidthRequest="100"
                       CornerRadius="50"
                       Padding="0"
                       HorizontalOptions="Start"
                       VerticalOptions="Start">
                    <Image Source="dotnet_bot.png"
                           Aspect="AspectFill"
                           HeightRequest="100"
                           WidthRequest="100"/>
                </Frame>

                <Grid Grid.Column="1"
                      RowDefinitions="Auto,Auto,Auto,auto"
                      RowSpacing="5"
                      VerticalOptions="Center">

                    <Label Grid.Row="0"
                           Text="John Doe"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#385897"/>

                    <Label Grid.Row="1"
                           Text="+977 9841234567"
                           FontSize="16"
                           TextColor="#666666"/>

                    <Label Grid.Row="2"
                           Text="john.doe@example.com"
                           FontSize="16"
                           TextColor="#666666"/>
                    <Label Grid.Row="3"
         Text="Butwal-14"
         FontSize="16"
         TextColor="#666666"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" 
      ColumnDefinitions="*,*,*" 
      ColumnSpacing="15"
      Padding="15,0"
      HorizontalOptions="Fill">

                <!-- Column 1: Total Bookings -->
                <Frame Grid.Column="0"
           BackgroundColor="#F0F4FF"
           CornerRadius="12"
           Padding="15,20"
           HasShadow="False">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="Total Bookings"
                   FontSize="14"
                   TextColor="#385897"/>
                        <Label Text="24"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#385897"
                   HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Column 2: Active Bookings -->
                <Frame Grid.Column="1"
           BackgroundColor="#E8F5E9"
           CornerRadius="12"
           Padding="15,20"
           HasShadow="False">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="Active Bookings"
                   FontSize="14"
                   TextColor="#2E7D32"/>
                        <Label Text="5"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#2E7D32"
                   HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Column 3: Reviews -->
                <Frame Grid.Column="2"
           BackgroundColor="#FFF3E0"
           CornerRadius="12"
           Padding="15,20"
           HasShadow="False">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="Reviews"
                   FontSize="14"
                   TextColor="#EF6C00"/>
                        <Label Text="4.8 ★"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#EF6C00"
                   HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <Grid Grid.Row="2" 
      RowDefinitions="Auto,Auto,Auto,Auto" 
      RowSpacing="12"
      Padding="20,10">

                <!-- Become a Technician -->
                <Button Grid.Row="0"
                        
            Text="Become a Technician"
            BackgroundColor="#F0F4FF"  
                         FontAttributes="Bold"
                    TextColor="#385897"
            BorderColor="#D6E0FF"
                   
                    BorderWidth="1"
            CornerRadius="8"
            HeightRequest="50"
            FontSize="16"/>

                    <!-- Enable Biometric -->
                    <Button Grid.Row="1"
            Text="Enable Biometric Login"
                             FontAttributes="Bold"
            BackgroundColor="#F8F9FF"  
                        TextColor="#385897"
            BorderColor="#E8ECFF"
                        
                        BorderWidth="1"
            CornerRadius="8"
            HeightRequest="50"
            FontSize="16"/>

                        <!-- Delete Account -->
                        <Button Grid.Row="2"
            Text="Delete Account"
            BackgroundColor="#FFEBEE"  
                                 FontAttributes="Bold"
                            TextColor="#D32F2F"
            BorderColor="#FFCDD2"
            BorderWidth="1"
            CornerRadius="8"
            HeightRequest="50"
            FontSize="16"/>

                            
                            <Button Grid.Row="3"
            Text="Logout"
            BackgroundColor="#F8F9FF"
                                     FontAttributes="Bold"
                                TextColor="#385897"
            BorderColor="#E8ECFF"
                                
                                BorderWidth="1"
            CornerRadius="8"
            HeightRequest="50"
            FontSize="16"/>

            </Grid>
        </Grid>
    </Grid>
</ContentPage>